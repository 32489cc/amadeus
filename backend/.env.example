# docker-compose 用の環境変数サンプル。
# 利用時は `cp .env.example .env` して値を調整してください。

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=amadeus
MYSQL_USER=amadeus
MYSQL_PASSWORD=amadeus

# --- Spring Boot から接続する場合（application.yml が参照） ---
# 未設定なら application.yml の :default 値（下記と同値）が使われる
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amadeus
DB_USER=amadeus
DB_PASSWORD=amadeus
REDIS_HOST=localhost
REDIS_PORT=6379
