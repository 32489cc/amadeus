<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amadeus.store.mapper.CategoryMapper">

    <!--
      TODO（你填/扩展）：
        - 最小可用：直接 SELECT * FROM product（下面这条已可用）
        - 后续按 ProductDTO 条件加 <where>/<if> 动态 SQL（category / status / priceMin/Max / q / 排序 / 分页）
    -->
    <select id="getcategorylist" resultType="com.amadeus.store.entity.Category">
        SELECT * FROM category order by sort_order
    </select>

    <update id="updatecategory">
        update category 
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="slug != null">
                slug = #{slug},
            </if>
            <if test="productCount != null">
                product_count = #{productCount},
            </if>    
            <if test="tone != null">
                tone = #{tone},
            </if>    
            <if test="sortOrder != null">
                sort_order=#{sortOrder}
            </if>   
        </set>
        WHERE id = #{id}
    </update>


</mapper>
